	<package name="curd" namespace="/curd" extends="json-default" strict-method-invocation="false">
		<action name="*CURD*" class="{1}CURDAction" method="{2}">
			<result type="json">
				<param name="excludeProperties">
					pojo,map,arr,frontPageName,jdata
				</param>
			</result>
			<result name="json" type="json">
            	<param name="root">json</param>
            	<param name="noCache">true</param>  
		        <param name="ignoreHierarchy">false</param>
			</result>
			<result name="modify">/common/{1}/{1}_modify.jsp</result>
			<result name="modify2">/common/{1}/{1}_modify.html</result>
			<result name="browse">/common/{1}/{1}_browse.jsp</result>
			<result name="browse2">/common/{1}/{1}_browse2.jsp</result>
			<result name="browse3">/common/{1}/{1}_browse3.jsp</result>
			
			<result name="mig_modify">/migcommon/{1}/{1}_modify.jsp</result>
			<result name="mig_modifypara">/migcommon/{1}/{1}_modify_${controlId}.jsp</result>
			<result name="mig_modify2">/migcommon/{1}/{1}_modify2.jsp</result>
			<result name="mig_browse">/migcommon/{1}/{1}_browse.jsp</result>
			<result name="mig_browsepara">/migcommon/{1}/{1}_browsepara_${controlId}.jsp</result>
			<result name="common_modify">/migcommon/${frontPageName}/${frontPageName}_modify.jsp</result>
			<result name="common_browse">/migcommon/${frontPageName}/${frontPageName}_browse.jsp</result>
			<result name="common_modify2">/migcommon/${foldName}/${frontPageName}.jsp</result>
			<result name="common_browse2">/migcommon/${foldName}/${frontPageName}.jsp</result>
			</action>
	</package>
	
	<package name="exp" namespace="/exp" extends="struts-default"  strict-method-invocation="false">
		<default-action-ref name="login" />
		<global-results>
			<!--下面定义的结果对所有的Action都有效 -->
			<result name="login">login.jsp</result>
			<result name="exception">/error.jsp</result>
			<result name="error">/error.jsp</result>
			<result name="success">/main.jsp</result>
		</global-results>

		<global-exception-mappings>
			<!-- 指Action抛出Exception异常时，转入名为exception的结果。 -->
			<exception-mapping result="exception" exception="java.lang.Exception" />
			<exception-mapping result="exception" exception="java.lang.Throwable" />
		</global-exception-mappings>
		<action name="*EXP*" class="{1}EXPAction" method="{2}">
			<result name="success" type="stream">
				<param name="bufferSize">4096</param>
				<param name="inputName">targetFile</param>
				<!-- 指定下载文件的内容类型，text/plain是默认类型  'txt' => 'text/plain'  -->
				<param name="contentType">application/vnd.ms-excel;charset=UTF-8</param>
				<!--动态获取文件名，从Action中的取得filename -->
				<param name="contentDisposition">
					attachment;filename="${fileName}"
				</param>
				<param name="contentCharSet">UTF-8</param>
			</result>
			<result name="xlsx" type="stream">
				<param name="bufferSize">4096</param>
				<param name="inputName">targetFile</param>
				<param name="contentType">application/vnd.openxmlformats-officedocument.spreadsheetml.sheet;charset=UTF-8</param>
				<param name="contentDisposition">
					attachment;filename="${fileName}"
				</param>
				<param name="contentCharSet">UTF-8</param>
			</result>
			<result name="txt" type="stream">
				<param name="bufferSize">4096</param>
				<param name="inputName">targetFile</param>
				<param name="contentType">text/plain;charset=UTF-8</param>
				<param name="contentDisposition">
					attachment;filename="${fileName}"
				</param>
				<param name="contentCharSet">UTF-8</param>
			</result>
			<result name="login">/login.jsp</result>
			<!-- for export progress display -->
			<result name="map">/common/response/map.jsp</result>
			<!-- for custom export use, return allColumns for choose -->
			<result name="sResponse">/common/response/sResponse.jsp</result>
		</action>
		<!-- 加上这个配置是为了在调用同一个action的同一个方法时得到不同的响应 ,暂时没有用到异步导出-->
		<action name="*Asyn*" class="{1}EXPAction" method="{2}">
			<result name="login">/login.jsp</result>
			<result name="success">/common/response/fileAbsPath.jsp</result>
		</action>
		<action name="*">
			<result>/login.jsp</result>
		</action>
	</package>
	
	<package name="imp" namespace="/imp" extends="struts-default"  strict-method-invocation="false">
		<default-action-ref name="login" />
		<global-results>
			<!--下面定义的结果对所有的Action都有效 -->
			<result name="login">login.jsp</result>
			<result name="exception">/error.jsp</result>
			<result name="input">/error.jsp</result>
			<result name="error">/error.jsp</result>
			<result name="success">/main.jsp</result>
		</global-results>

		<global-exception-mappings>
			<!-- 指Action抛出Exception异常时，转入名为exception的结果。 -->
			<exception-mapping result="exception" exception="java.lang.Exception" />
			<exception-mapping result="exception" exception="java.lang.Throwable" />
		</global-exception-mappings>
		<action name="*IMP*" class="{1}IMPAction" method="{2}">
            <interceptor-ref name="fileUpload"> 
                <!-- {1}小写开头，spring管理
                firefox    image/jpeg   image/bmp   image/gif   image/png 
					 ie 6  image/pjpeg  image/bmp   image/gif   image/x-png 
					 ie 7  image/pjpeg  image/bmp   image/gif   image/x-png 
					 ie 8  image/pjpeg  image/bmp   image/gif   image/x-png 
                image/bmp,
	                image/png,image/x-png
	                image/gif,
	                image/jpg,image/jpeg,image/pjpeg,
	                text/bat,application/bat,application/x-bat,
	                
	                text/plain,
	                application/excel
	                application/vnd.ms-excel  2003 5.0/95
	                application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
	                
	                application/octet-stream,
	                application/zip,
	                application/x-zip-compressed,
                 -->
                <param name="allowedTypes">text/plain,application/vnd.ms-excel,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet</param> 
                <param name="maximumSize">60000000</param> 
            </interceptor-ref> 
            <interceptor-ref name="defaultStack"/>    
            <!-- savePath not inject there, it is auto set config Value 
            windows savePath 
            <param name="savePath">C:\usr\authorityfile\</param>
             -->
            <!-- 
            linux
            <param name="savePath">/wls/authorityfile/</param>
              -->
            <result name="success">/common/response/sResponse.jsp</result>
			<result name="login">/login.jsp</result>
			<!-- for export progress display -->
			<result name="map">/common/response/map.jsp</result>
			<!-- for custom import use, return allColumns for choose -->
			<result name="sResponse">/common/response/sResponse.jsp</result>
		</action>
		<action name="*">
			<result>/login.jsp</result>
		</action>
	</package>
	
</struts>