<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE struts PUBLIC "-//Apache Software Foundation//DTD Struts Configuration 2.3//EN" "http://struts.apache.org/dtds/struts-2.3.dtd">
<struts>
	<constant name="struts.enable.DynamicMethodInvocation" value="true" />
	<constant name="struts.i18n.encoding" value="UTF-8" />
	<constant name="struts.i18n.resources" value="messageResource" />
	<constant name="struts.locale" value="zh_CN" />
	<constant name="struts.devMode" value="true" />
	<!-- -->
	<!-- <constant name="struts.objectFactory" value="spring" /> -->
	<constant name="struts.objectFactory"
		value="org.apache.struts2.spring.StrutsSpringObjectFactory" />
	<constant name="struts.objectFactory.spring.autoWire" value="name" />
	
	<!-- REST and non-RESTful URL's Together Configuration -->
<!-- xhtml,,xml,json,action  -->
<constant name="struts.action.extension" value="xhtml,xml,action"/>
<constant name="struts.mapper.class" value="org.apache.struts2.dispatcher.mapper.PrefixBasedActionMapper" />
<!-- <constant name="struts.rest.defaultExtension" value="json" /> -->
<constant name="struts.mapper.prefixMapping" value="/rest:rest,:struts"/>
<constant name="struts.rest.namespace" value="/rest" /> 

<!--  Overwrite Convention -->
<constant name="struts.convention.action.suffix" value="Controller"/>
<constant name="struts.convention.action.mapAllMatches" value="true"/>
<constant name="struts.convention.default.parent.package" value="rest-default"/>
<constant name="struts.convention.package.locators" value="example"/>

	<package name="authority" extends="struts-default" strict-method-invocation="false">

        <action name="loginServlet" class="loginAction">
<!--             <result type="redirect">/Webmain/main.html</result> -->
            <result type="redirect">frame-en.jsp</result>
            <result name="error" type="redirect">/login-en.jsp</result>
		</action>
		<action name="logoutServlet" class="logoutAction">
            <result type="redirect">/login-en.jsp</result>
		</action>
    </package>
     
	<package name="admin" namespace="/admin" extends="struts-default" strict-method-invocation="false">
		<default-action-ref name="login" />
		<global-results>
			<!--下面定义的结果对所有的Action都有效 -->
			<result name="login">login.jsp</result>
			<result name="exception">/error.jsp</result>
			<result name="success">/main.jsp</result>
		</global-results>

		<global-exception-mappings>
			<!-- 指Action抛出Exception异常时，转入名为exception的结果。 -->
			<exception-mapping exception="java.lang.Exception"
				result="exception" />
			<exception-mapping exception="java.lang.Throwable"
				result="exception" />
		</global-exception-mappings>

		<!-- 默认类型 -->
		<action name="*Admin*" class="{1}Action" method="{2}">
			<result name="sResponse">/common/response/sResponse.jsp</result>
			<result name="add">/admin/{1}/{1}_add.jsp</result>
			<result name="modify">/admin/{1}/{1}_modify.jsp</result>
			<result name="draftedit">/admin/{1}/{1}_draftedit.jsp</result>
			<result name="browse">/admin/{1}/{1}_browse.jsp</result>
			<result name="browse2">/admin/{1}/{1}_browse.jsp</result>
			<result name="menu">/admin/{1}/{1}_menu.jsp</result>
			<result name="draftbrowse">/admin/{1}/{1}_draftbrowse.jsp</result>
			<result name="success">/admin/{1}/success_{2}.jsp</result>
			<result name="success_add">/admin/{1}/success_add.jsp</result>
			<result name="afterAddFromDraft">/admin/{1}/success_{2}.jsp</result>
			<result name="repeatSubmit">/admin/{1}/{1}_repeatSubmit.jsp</result>
			<result name="main">/admin/{1}/{1}_main.jsp</result>
			<result name="login">login.jsp</result>
			<result name="error">error.jsp</result>
			<result name="input">/admin/{1}/{1}.jsp</result>
		</action>

		<action name="*">
			<result>/login.jsp</result>
		</action> 
	</package>

	<package name="common" namespace="/common" extends="struts-default" strict-method-invocation="false">
		<default-action-ref name="login" />
		<global-results>
			<!--下面定义的结果对所有的Action都有效 -->
			<result name="login">login.jsp</result>
			<result name="exception">/error.jsp</result>
			<result name="success">/main.jsp</result>
		</global-results>

		<global-exception-mappings>
			<!-- 指Action抛出Exception异常时，转入名为exception的结果。 -->
			<exception-mapping result="exception" exception="java.lang.Exception" />
			<exception-mapping result="throwable" exception="java.lang.Throwable" />
		</global-exception-mappings>
		<!-- 默认类型 -->
		<action name="*Common*" class="{1}Action" method="{2}">
			<result name="add">/common/{1}/{1}_add.jsp</result>
			<result name="modify">/common/{1}/{1}_modify.jsp</result>
			<result name="modify2">/common/{1}/{1}_modify.html</result>
			<result name="draftedit">/common/{1}/{1}_draftedit.jsp</result>
			<result name="browse">/common/{1}/{1}_browse.jsp</result>
			<result name="browse2">/common/{1}/{1}_browse2.jsp</result>
			<result name="browse3">/common/{1}/{1}_browse3.jsp</result>
			<result name="sResponse">/common/response/sResponse.jsp</result>
			<result name="draftbrowse">/common/{1}/{1}_draftbrowse.jsp</result>
			<result name="success">/common/{1}/success_{2}.jsp</result>
			<result name="success_add">/common/{1}/success_add.jsp</result>
			<result name="afterAddFromDraft">/common/{1}/success_{2}.jsp</result>
			<result name="repeatSubmit">/common/{1}/{1}_repeatSubmit.jsp</result>
			<result name="main">/common/{1}/main.jsp</result>
			<result name="upload">/public/publicData.jsp</result>
			<result name="login">/login.jsp</result>
			<result name="error">/error.jsp</result>
			<result name="input">/common/{1}/{1}.jsp</result>
		</action>

		<action name="*">
			<result>/login.jsp</result>
		</action>
	</package>
	
	<package name="public" namespace="/public" extends="struts-default" strict-method-invocation="false">
		<default-action-ref name="login" />
		<global-results>
			<!--下面定义的结果对所有的Action都有效 -->
			<result name="login">login.jsp</result>
			<result name="exception">/error.jsp</result>
			<result name="success">/main.jsp</result>
		</global-results>

		<global-exception-mappings>
			<!-- 指Action抛出Exception异常时，转入名为exception的结果。 -->
			<exception-mapping result="exception" exception="java.lang.Exception" />
			<exception-mapping result="exception" exception="java.lang.Throwable" />
		</global-exception-mappings>
		<!-- 默认类型 -->
		<action name="*Public*" class="{1}Action" method="{2}">
			<result name="add">/public/{1}/{1}_add.jsp</result>
			<result name="modify">/public/{1}/{1}_modify.jsp</result>
			<result name="draftedit">/public/{1}/{1}_draftedit.jsp</result>
			<result name="browse">/public/{1}/{1}_browse.jsp</result>
			<result name="browse2">/public/{1}/{1}_browse.jsp</result>
			<result name="menu">/public/{1}/{1}_menu.jsp</result>
			<result name="draftbrowse">/public/{1}/{1}_draftbrowse.jsp</result>
			<result name="success">/public/{1}/success_{2}.jsp</result>
			<result name="success_add">/public/{1}/success_add.jsp</result>
			<result name="afterAddFromDraft">/public/{1}/success_{2}.jsp</result>
			<result name="repeatSubmit">/public/{1}/{1}_repeatSubmit.jsp</result>
			<result name="main">/public/{1}/main.jsp</result>
			<result name="login">login.jsp</result>
			<result name="error">error.jsp</result>
			<result name="input">/public/{1}/{1}.jsp</result>
		</action>

		<action name="*">
			<result>/index.html</result>
		</action>
	</package>

	<package name="busi" namespace="/busi" extends="json-default" strict-method-invocation="false">
		<action name="*BUSI*" class="{1}BUSIAction" method="{2}">
			<result name="success" type="json">
            	<param name="root">json</param>
            	<param name="noCache">true</param>  
		        <param name="ignoreHierarchy">false</param>
			</result>
			<result name="mig_browse">/migcommon/{1}/{1}_browse${pagePostfix}.jsp</result>
			<result name="sResponse">/common/response/sResponse.jsp</result>
		</action>
	</package>
	
	<package name="cbb" namespace="/cbb" extends="json-default" strict-method-invocation="false">
		<action name="*CBB*" class="{1}CBBAction" method="{2}">
			<result name="sResponse">/common/response/sResponse.jsp</result>
			<result name="success" type="json">
            	<param name="root">json</param>
            	<param name="noCache">true</param>  
		        <param name="ignoreHierarchy">false</param>
			</result>
		</action>
	</package>
	<package name="tree" namespace="/tree" extends="json-default" strict-method-invocation="false">
		<action name="*TREE*" class="{1}TREEAction" method="{2}">
			<result name="sResponse">/common/response/sResponse.jsp</result>
			<result name="map">/common/response/map.jsp</result>
			<result name="input">error.jsp</result>
			<result name="success" type="json">
            	<param name="root">json</param>
            	<param name="noCache">true</param>  
		        <param name="ignoreHierarchy">false</param>
			</result>
		</action>
	</package>
	
	<package name="query" namespace="/query" extends="json-default" strict-method-invocation="false">
		<action name="*QUERY*" class="{1}QUERYAction" method="{2}">
			<result type="json">
				<!-- to support JSONP -->
				<param name="callbackParameter">callback</param>
			</result>
			<result name="total" type="json">
				<param name="root">total</param>
            	<param name="noCache">true</param>  
		        <param name="ignoreHierarchy">false</param>
			</result>
			<result name="json" type="json">
				<param name="root">json</param>
            	<param name="noCache">true</param>  
		        <param name="ignoreHierarchy">false</param>
			</result>
		</action>
	</package>
	
	<package name="print" namespace="/print" extends="struts-default" strict-method-invocation="false">
		<action name="*PRINT*" class="{1}PRINTAction" method="{2}">
			<result>/migcommon/{1}/{1}_print.jsp</result>
			<result name="custom_print">/migcommon/{1}/{1}_print_${printName}.jsp</result>
		</action>
	</package>
	
